@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Curses)
find_dependency(Threads)
find_dependency(PNG)
if(@TIGT_WITH_LIBCACA@)
    find_dependency(PkgConfig)
    pkg_check_modules(CACA REQUIRED IMPORTED_TARGET caca)
endif()
if(NOT TARGET tigt::curses)
    add_library(tigt::curses INTERFACE IMPORTED)
    set_target_properties(tigt::curses PROPERTIES
        INTERFACE_LINK_LIBRARIES "${CURSES_LIBRARIES}"
        INTERFACE_INCLUDE_DIRECTORIES "${CURSES_INCLUDE_DIRS}")
endif()
if(@TIGT_WITH_KEYBOARD@ AND NOT TARGET tigt::keyboard)
    set_and_check(_tigt_keyboard_library "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libpc_xt_keyboard.a")
    add_library(tigt::keyboard STATIC IMPORTED)
    set_target_properties(tigt::keyboard PROPERTIES
        IMPORTED_LOCATION "${_tigt_keyboard_library}"
        IMPORTED_LINK_INTERFACE_LANGUAGES C
        INTERFACE_LINK_LIBRARIES "@TIGT_KEYBOARD_NATIVE_LIBRARIES@")
    unset(_tigt_keyboard_library)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/tigtTargets.cmake")
check_required_components(tigt)
